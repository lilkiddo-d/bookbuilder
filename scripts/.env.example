# Chain to operate on: 4663 (Robinhood Chain mainnet) or 31337 (local anvil fork)
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Signing: "keystore" uses `cast send --account bookbuilder-keeper` (Foundry keystore, never a raw key).
#          "unlocked" is ONLY for a local anvil fork (uses anvil's unlocked account in KEEPER_FROM).
#          "dry" logs what it would do and sends nothing (default).
KEEPER_SIGNER=dry
KEEPER_ACCOUNT=bookbuilder-keeper
# Optional: file containing the keystore password so the keeper can run unattended.
# Keep it outside the repo with 0600 permissions. If unset, cast prompts interactively.
KEEPER_PASSWORD_FILE=
KEEPER_FROM=
# Loop interval in seconds and per-tick tx cap
KEEPER_INTERVAL=60
KEEPER_MAX_TX=10
# Also push refunds/tokens to investors (settle) once escrows are Failed/Delivered
KEEPER_AUTO_SETTLE=true
# Also call FeeCollector.distribute(USDG) once per this many seconds (0 = off)
KEEPER_DISTRIBUTE_EVERY=86400
# Optional: first L2 block to scan for deposits (defaults to deployBlock from the deployment file)
KEEPER_FROM_BLOCK=
