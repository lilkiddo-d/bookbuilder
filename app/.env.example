# Chain used for reads when no wallet is connected (4663 = Robinhood Chain mainnet, 31337 = local fork)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=4663
# RPC for Robinhood Chain mainnet (defaults to the public RPC)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# RPC for the local anvil fork (chain id 31337)
NEXT_PUBLIC_FORK_RPC_URL=http://127.0.0.1:8545
# Show the local fork network in the wallet/network list ("true"/"false"). Defaults to "true" in dev, "false" in production builds.
NEXT_PUBLIC_ENABLE_FORK=true
# Optional WalletConnect Cloud project id. Empty => injected / MetaMask / Coinbase wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $BOOK project token address. Empty => all token features (staking, tiers, fee sharing) are hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Comma-separated ISO-3166 alpha-2 country codes to geoblock (e.g. "US,KP,IR"). Empty => no geoblocking.
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
# IPFS gateway used to link documents (must end with a slash)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
